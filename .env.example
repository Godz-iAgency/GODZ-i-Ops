# Server-side only. Never expose these values through NEXT_PUBLIC_* variables.
DATA_PROVIDER=google-sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Accepts either a full PEM key with literal \\n separators or the base64 key body from the JSON file.
GOOGLE_SHEETS_PRIVATE_KEY=

# Airtable is optional and only used when DATA_PROVIDER=airtable.
AIRTABLE_PAT=
AIRTABLE_BASE_MUSIC=
APIFY_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
APP_URL=
